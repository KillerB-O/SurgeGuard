# Copy to .env and adjust for your machine.

API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173

# postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://surgeguard:surgeguard@localhost:5432/surgeguard

# Shared secret n8n sends in the X-Service-Token header (D-08). Left blank
# here on purpose: an unset value fails closed (see Settings.service_token),
# so a deployment must set this deliberately rather than inherit a default.
SERVICE_TOKEN=

# False for local plain-http development. A `secure` cookie is enforced by
# the browser, not the server -- set true only when serving over https, or
# every session cookie is silently dropped by the client.
SESSION_COOKIE_SECURE=false
