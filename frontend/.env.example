# Copy to .env.local and adjust.
# Backend mounts read/simulation routers under API_PREFIX (default /api).
VITE_API_BASE=http://localhost:8000/api

# Facility shown by default. Backend defaults to WH-01 too.
VITE_FACILITY_ID=WH-01

# "mock" renders fixtures with no backend. "live" calls VITE_API_BASE.
VITE_DATA_SOURCE=live
