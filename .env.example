# Copy to .env at the repo root. `.env` is gitignored; this file is not.
#
# The shared secret n8n presents to the backend on the six endpoints it calls
# (event ingestion and recovery-action execution). It is a machine credential:
# it grants no user identity and no session, and it is not a login of any kind.
#
# The SAME value must reach both services -- docker-compose.yml passes it to the
# backend as SERVICE_TOKEN (what the backend expects) and to n8n as
# SURGEGUARD_SERVICE_TOKEN (what the workflow header expression reads). If they
# disagree, every n8n call returns 401 and it looks like a backend fault.
#
# Both are declared with `:?` in docker-compose.yml, so leaving this unset fails
# `docker compose up` immediately instead of starting a half-working stack.
#
# Generate a suitable value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SURGEGUARD_SERVICE_TOKEN=

# --- Email (optional) ------------------------------------------------------
#
# LEAVING THESE BLANK IS FULLY SUPPORTED and is the default way to run this
# project: with no SMTP host, verification and password-reset emails are
# written to the backend log instead of being sent. Unlike the service token
# above, these are NOT declared with `:?`, so an unset value never stops the
# stack -- see the comment in docker-compose.yml.
#
# To send real mail, the project uses Brevo's free tier (300 emails/day, SMTP
# relay included, no credit card). Setup is four steps, documented in
# backend/README.md under "Email".
#
# SMTP_PASSWORD is a Brevo *SMTP key*, generated under SMTP & API -> SMTP.
# It is NOT your Brevo account password -- using the account password is the
# most common reason authentication fails.
#
# SMTP_SENDER must be an address you have verified in Brevo, or the relay
# refuses the message. Verifying a sender does not require owning a domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# Where emailed links point. With FRONTEND_BASE_URL set, links open the
# frontend's /verify-email and /set-new-password pages. Leave it blank to have
# the backend answer the links itself at PUBLIC_BASE_URL.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- Seeded demo account (optional, ACCESS-03) ------------------------------
#
# LEAVING THESE BLANK IS FULLY SUPPORTED: with no demo credentials configured,
# the backend seeds nothing at startup and no extra account exists. Set both
# to give the live demo an account that can log in without completing signup
# or clicking an email verification link -- the account is created already
# verified.
#
# DEMO_USER_PASSWORD is a REAL CREDENTIAL, not a placeholder. Set it to
# something you would not mind a judge or teammate typing into the sign-in
# form, and do not commit it -- this file stays blank; only your gitignored
# .env should ever carry a real value.
DEMO_USER_EMAIL=demo@surgeguard.local
DEMO_USER_PASSWORD=SurgeGuardDemo1!
